{
  "version": 2,
  "builds": [
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tavily-test.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "api/chat.js"
    },
    {
      "src": "/api/search",
      "dest": "api/search.js"
    },
    {
      "src": "/api/tavily-test",
      "dest": "api/tavily-test.js"
    }
  ]
}